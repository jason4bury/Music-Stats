# Music Stats settings. Copy this file to .env next to docker-compose.yml and fill in the values.
# .env holds a real password: it is gitignored, so never commit it.

# Your music folder on this machine, read-only (the app never writes to it). Settings on the page
# then picks which folders inside it are read.   Windows: D:/Music   Linux/NAS: /volume1/music
MUSIC_FOLDER=/path/to/music
# Music somewhere else too? Set this and remove the # from its line in docker-compose.yml.
# MUSIC_FOLDER_2=/path/to/more-music

# Look for new and changed files every this many hours (0 = only at start-up and when you press Rescan).
SCAN_HOURS=24

# Sign-in (required). The app will not start until these are changed from the examples.
APP_USERNAME=your-username
APP_PASSWORD=change-me

# Long random string used to sign the sign-in cookie (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-long-random-string

# --- Running without Docker (npm start) ---
# Set MUSIC_ROOT to the folder that holds your music, such as MUSIC_ROOT=D:/ (Settings can pick any
# folder inside it). The cache and settings go in ./data unless DATA_DIR is set; PORT if you want a
# port other than 3050.
# Optional: the folders to read until any are picked in Settings, as Name=folder, comma-separated,
# such as COLLECTIONS=Music=D:/Music, Soundtracks=E:/Film Scores
